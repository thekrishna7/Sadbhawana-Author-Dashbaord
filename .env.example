# Public Client Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL="your_supabase_project_url"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"

# Database Connection (Supabase PostgreSQL / Local PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/sadbhawana_db"

# JWT Authentication Secret
JWT_SECRET="your_jwt_secret_key_here"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Email Notification Configuration (Nodemailer SMTP)
ADMIN_EMAIL="admin@yourdomain.com"
SMTP_USER="your_smtp_email@gmail.com"
SMTP_PASS="your_16_digit_google_app_password"
SMTP_FROM="Sadbhawana Publication <your_smtp_email@gmail.com>"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
